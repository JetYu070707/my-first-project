# 复制成 .env 后生效：Copy-Item .env.example .env
# 注意：值里含空格时必须要用双引号包住，否则 uv 加载 .env 会解析失败、变量直接丢失。

# 部分站点（B 站）会校验 User-Agent，缺了它返回 412 Precondition Failed
HTTP_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"

# 最大并发数
CONCURRENCY=6

# 单请求超时（秒）
REQUEST_TIMEOUT=10

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 示例密钥占位符：真实密钥只写在 .env，永远不进仓库
API_KEY=
